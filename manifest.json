{
  "schemaVersion": 1,
  "id": "greyforge.cris",
  "name": "CRIS",
  "version": "1.0.0",
  "author": "Greyforge Labs",
  "license": "MIT",
  "description": "CPU, RAM, Internet, Storage: one line of bar text from a 16 KB process. Click it for settings.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "defaultSection": "left",
    "defaults": { "cpuTemp": false, "gpu": false, "swap": false, "ping": true, "speed": false, "interval": 3, "labels": "cris", "disks": "/" }
  }
}
